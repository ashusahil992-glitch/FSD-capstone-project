# === Backend (Render / Local Spring Boot + MongoDB Atlas) ===
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusbazaar?retryWrites=true&w=majority
MONGODB_DATABASE=campusbazaar
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
ADMIN_EMAIL=admin@campusbazaar.demo
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SEED_ENABLED=true

# === Frontend (Vercel / Local Vite) ===
# Locally leave as /api (Vite proxies to http://localhost:8080)
# On Vercel set to your Render backend URL, e.g. https://campusbazaar-backend.onrender.com
VITE_API_BASE_URL=/api
